{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@main/*": ["./src/main/*"],
      "@common/*": ["./src/common/*"],
      "pluggable-electron/renderer": ["./node_modules/pluggable-electron/dist/execution.es.d.ts"],
      "pluggable-electron/main": ["./node_modules/pluggable-electron/dist/pluginMgr.d.ts"],
      "pluggable-electron/facade": ["./node_modules/pluggable-electron/dist/facade.d.ts"]
    }
  },
  "include": ["src/renderer/**/*", "src/common/**/*"],
  "references": [{ "path": "./src/main/tsconfig.json" }]
}
